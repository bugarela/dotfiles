{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.9"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "my-workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "terminals",
              "type": "block",
              "content": { "mod": "my-terminals" },
              "size": { "weight": 1 },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "my-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "spaces",
              "type": "block",
              "content": { "mod": "my-spaces" },
              "size": { "px": 32 },
              "min": 32
            }
          ],
          "resizable": false
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "my-workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 4,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "my-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "my-changes"
                      }
                    },
                    {
                      "id": "review",
                      "type": "block",
                      "content": {
                        "mod": "my-review"
                      }
                    },
                    {
                      "id": "bell",
                      "type": "block",
                      "content": {
                        "mod": "my-bell"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "hidden": true
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "paper",
    "dark": "ink"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "floating": [
    {
      "id": "voice-dictation",
      "content": {
        "mod": "my-dictation"
      },
      "edge": "bottom",
      "align": "center"
    },
    {
      "id": "appearance-sync",
      "content": {
        "mod": "my-appearance-sync"
      },
      "edge": "bottom",
      "align": "start"
    }
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "my-menu"
}
